# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored - never commit it, never paste it in chat.
#
# RECOMMENDED: separate fields. Nothing is parsed, so a password
# containing @ : / or # causes no problems.
#
# Get these from Supabase -> Project Settings -> Database -> Connection string
# Choose "Session pooler" (NOT the direct db.<ref>.supabase.co host, which is
# IPv6-only on the free tier and will fail on most home internet).
#
# The pooler URI looks like:
#   postgresql://postgres.abcdefghij:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#                └────── user ─────┘          └──────────── host ───────────────┘ └port┘

SUPABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=postgres.your_project_ref
SUPABASE_PASSWORD=your-password-here-raw-no-quotes-no-encoding
SUPABASE_DB=postgres

# Alternative (only if your password has no special characters):
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
